# Site URL (set to https://cooper.fitness in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 — get from https://analytics.google.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Meta Pixel — get from https://www.facebook.com/events_manager
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXX

# Google reCAPTCHA v2
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# EmailJS for inquiry emails
EMAILJS_SERVICE_ID=service_xxxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxx
EMAILJS_PRIVATE_KEY=xxxxxxxx

# Stripe - use test keys locally and live keys only in production.
# Prefer a restricted live API key (rk_live_...) with PaymentIntents read/write access.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=rk_live_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Founding Stripe one-time offer (server-only IDs; do not expose in client code)
FOUNDING_STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxx
FOUNDING_STRIPE_PRODUCT_ID=prod_xxxxxxxxxxxxxxxx

# Optional: CRM webhook for lead forwarding
CRM_WEBHOOK_URL=https://example.com
CRM_WEBHOOK_SECRET=

# Founding cohort checkout (routes fail closed until all values are configured)
FOUNDING_HOMEPAGE_ENABLED=false
FOUNDING_CHECKOUT_ENABLED=false
FOUNDING_CRM_ORIGIN=http://localhost:3001
FOUNDING_INTERNAL_API_SECRET=
NEXT_PUBLIC_SUPPORT_EMAIL=evan@cooper.fitness
NEXT_PUBLIC_FOUNDING_TERMS_URL=https://cooper.fitness/terms
NEXT_PUBLIC_FOUNDING_PRIVACY_URL=https://cooper.fitness/privacy
NEXT_PUBLIC_FOUNDING_REFUND_POLICY_URL=https://cooper.fitness/refunds
